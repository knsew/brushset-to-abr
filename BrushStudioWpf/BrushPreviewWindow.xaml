<Window x:Class="BrushStudio.BrushPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="笔刷预览"
        Width="760" Height="660"
        MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource TextStrongBrush}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="InfoText"
                   Grid.Row="1"
                   FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap" />

        <Border x:Name="ImageHost"
                Grid.Row="2"
                Background="{StaticResource CheckerBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,10,0,10"
                ClipToBounds="True">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   Margin="14"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ComboBox x:Name="BgBox"
                      Style="{StaticResource ModernComboBox}"
                      MinWidth="96"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      SelectionChanged="OnBackgroundChanged">
                <ComboBoxItem Content="透明" />
                <ComboBoxItem Content="白色" />
                <ComboBoxItem Content="灰色" />
                <ComboBoxItem Content="黑色" />
            </ComboBox>
            <Button x:Name="CloseButton"
                    Content="关闭"
                    Style="{StaticResource ModernButton.Primary}"
                    Width="104"
                    Click="OnCloseClicked" />
        </StackPanel>
    </Grid>
</Window>
