<UserControl x:Class="BrushStudio.PackageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Border x:Name="Root"
            CornerRadius="10"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="8"
            Cursor="Hand"
            Margin="0,0,0,8"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource ThumbHostBrush}"
                    CornerRadius="6"
                    Width="40" Height="40"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image x:Name="ThumbImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="2" />
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="NameText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextStrongBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MetaText"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
