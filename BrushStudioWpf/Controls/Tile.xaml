<UserControl x:Class="BrushStudio.Tile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="TileRoot"
             Focusable="True">
    <Border x:Name="Root"
            CornerRadius="8"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="6"
            Cursor="Hand"
            Margin="2"
            SnapsToDevicePixels="True">
        <Grid>
            <StackPanel>
                <Border x:Name="ThumbHost"
                        Background="{StaticResource ThumbHostBrush}"
                        CornerRadius="6"
                        Padding="2"
                        Height="64"
                        Margin="0,0,0,5">
                    <Grid>
                        <Image x:Name="ThumbImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border x:Name="FidelityBadge"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Background="{StaticResource SuccessBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="4" />
                    </Grid>
                </Border>
                <TextBlock x:Name="NameText"
                           FontSize="11"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           MaxHeight="30"
                           LineHeight="14"
                           TextAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StarText"
                       Text="★"
                       FontSize="12"
                       Foreground="{StaticResource WarningBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,4,4,0"
                       Visibility="Collapsed" />
            <Border x:Name="SelectBadge"
                    Width="18" Height="18"
                    CornerRadius="9"
                    Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,4,4"
                    Visibility="Collapsed">
                <TextBlock Text="✓"
                           Foreground="White"
                           FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
