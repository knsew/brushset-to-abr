<Window x:Class="BrushStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:BrushStudio"
        Title="Brushset 转 ABR"
        Width="1320" Height="820"
        MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        AllowDrop="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />   <!-- 自绘标题栏 -->
            <RowDefinition Height="*" />     <!-- 主内容三栏 -->
            <RowDefinition Height="Auto" />  <!-- 底部操作栏：Auto 高度，由内容撑开，绝不截断 -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             标题栏
             ============================================================ -->
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Content="－" Style="{StaticResource TitleBarButton}" Click="OnMinimize" />
                    <Button x:Name="MaxButton" Content="□" Style="{StaticResource TitleBarButton}" Click="OnMaximize" />
                    <Button x:Name="CloseButton" Content="×" Style="{StaticResource TitleBarButton}" Click="OnClose" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="Brushset 转 ABR"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextStrongBrush}" />
                    <TextBlock x:Name="VersionText"
                               Text=""
                               FontSize="10.5"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="10,1,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================
             主内容：Grid 三栏 1.5* / 5* / 2.5*
             ============================================================ -->
        <Grid Grid.Row="1" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="5*" MinWidth="400" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2.5*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource ColumnSplitter}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />
            <GridSplitter Grid.Column="3"
                          Style="{StaticResource ColumnSplitter}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <!-- 左侧：示例与预设列表（ScrollViewer 包裹，绝不挤压） -->
            <Border Grid.Column="0"
                    Margin="0,0,4,0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource CardShadow}"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- 笔刷包标题 -->
                        <RowDefinition Height="Auto" />   <!-- 添加/移除/清空 -->
                        <RowDefinition Height="*" />      <!-- 包列表 -->
                        <RowDefinition Height="16" />     <!-- 分组间隔 -->
                        <RowDefinition Height="Auto" />   <!-- 笔刷标题 + 只看收藏 -->
                        <RowDefinition Height="Auto" />   <!-- 搜索框 -->
                        <RowDefinition Height="Auto" />   <!-- 保真筛选 -->
                        <RowDefinition Height="Auto" />   <!-- 排序 -->
                        <RowDefinition Height="*" />      <!-- 笔刷网格 -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Rectangle DockPanel.Dock="Left" Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="PackageTitle"
                                   Text="笔刷包"
                                   FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"
                                   Foreground="{StaticResource TextStrongBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AddButton" Content="添加" Style="{StaticResource ModernButton.Secondary}" Click="OnAddFiles" Margin="0,0,6,0" />
                        <Button x:Name="RemoveButton" Content="移除" Style="{StaticResource ModernButton.Secondary}" Click="OnRemove" Margin="0,0,6,0" />
                        <Button x:Name="ClearButton" Content="清空" Style="{StaticResource ModernButton.Ghost}" Click="OnClearAll" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />   <!-- 收藏夹固定置顶，始终可见 -->
                            <RowDefinition Height="*" />      <!-- 包列表滚动区 -->
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="FavoritesHost" Grid.Row="0" />
                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="PackageScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PackageList" />
                            </ScrollViewer>
                            <Border x:Name="ImportPanel"
                                    Background="#E6F4F4F6"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="ImportStatus" Text="正在导入…" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="ImportProgress" Style="{StaticResource ModernProgress}" Height="4" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="EmptyState" Background="Transparent" Padding="14">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="拖入 .brushset 笔刷包"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="或点击「添加」选择文件，&#x0a;也可以先试试内置示例"
                                               FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0,8,0,12" />
                                    <Button x:Name="SampleButton"
                                            Content="试试示例笔刷"
                                            Style="{StaticResource ModernButton.Primary}"
                                            HorizontalAlignment="Center"
                                            Click="OnLoadSample" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <DockPanel Grid.Row="4" Margin="0,0,0,10">
                        <CheckBox x:Name="FavoritesOnly"
                                  DockPanel.Dock="Right"
                                  Content="只看收藏"
                                  Style="{StaticResource ModernCheckBox}"
                                  VerticalAlignment="Center"
                                  Checked="OnFavoritesFilter"
                                  Unchecked="OnFavoritesFilter" />
                        <Rectangle DockPanel.Dock="Left" Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BrushTitle"
                                   Text="笔刷"
                                   FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"
                                   Foreground="{StaticResource TextStrongBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <local:SearchBox x:Name="Search" Grid.Row="5" Margin="0,0,0,8" />

                    <ComboBox x:Name="FidelityFilter"
                              Grid.Row="6"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,8"
                              SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="全部保真" />
                        <ComboBoxItem Content="高保真" />
                        <ComboBoxItem Content="近似" />
                        <ComboBoxItem Content="受限" />
                    </ComboBox>

                    <ComboBox x:Name="SortBox"
                              Grid.Row="7"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,10"
                              SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="按名称排序" />
                        <ComboBoxItem Content="按保真分排序" />
                    </ComboBox>

                    <Grid Grid.Row="8">
                        <ScrollViewer x:Name="BrushScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnBrushScrollChanged">
                            <ItemsControl x:Name="BrushList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="BrushEmpty"
                                   Text="点选左侧笔刷包查看笔刷"
                                   FontSize="11.5"
                                   Foreground="{StaticResource FaintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 中间：绘画测试画布区（自动填满剩余空间，居中自适应） -->
            <Border Grid.Column="2"
                    Margin="4,0,4,0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource CardShadow}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <StackPanel x:Name="CanvasTools" Orientation="Horizontal">
                            <Rectangle DockPanel.Dock="Left" Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CanvasTitle"
                                       Text="画布"
                                       FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"
                                       Foreground="{StaticResource TextStrongBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button x:Name="ColorButton" Style="{StaticResource ModernButton.Compact}" Click="OnPickColor" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ColorSwatch" Width="11" Height="11" Fill="Black" Stroke="#FFC9C9D0" StrokeThickness="1" VerticalAlignment="Center" />
                                    <TextBlock Text="  颜色" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ComboBox x:Name="BackgroundBox"
                                      Style="{StaticResource ModernComboBox}"
                                      MinWidth="64"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnCanvasBackgroundChanged">
                                <ComboBoxItem Content="透明" />
                                <ComboBoxItem Content="白色" />
                                <ComboBoxItem Content="灰色" />
                                <ComboBoxItem Content="黑色" />
                            </ComboBox>
                            <Button x:Name="ClearCanvasButton" Content="清空" Style="{StaticResource ModernButton.Compact}" Click="OnClearCanvas" Margin="0,0,6,0" />
                            <Button x:Name="AutoPreviewButton" Content="自动预览" Style="{StaticResource ModernButton.Compact}" Click="OnToggleAutoPreview" Margin="0,0,6,0" />
                            <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource ModernButton.Compact}" Click="OnZoomOut" Margin="0,0,2,0" />
                            <Border x:Name="ZoomLabel"
                                    Background="{StaticResource CardAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,5"
                                    Margin="0,0,2,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ZoomText" Text="100%" FontSize="11" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource ModernButton.Compact}" Click="OnZoomIn" Margin="0,0,2,0" />
                            <Button x:Name="FitButton" Content="适配" Style="{StaticResource ModernButton.Compact}" Click="OnFit" Margin="0,0,6,0" />
                            <Button x:Name="CompareButton" Content="Procreate 对比" Style="{StaticResource ModernButton.Compact}" Click="OnCompare" ToolTip="并排渲染：Procreate 语义 vs 转换后 ABR 行为，验证转换还原度" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1"
                            Background="{StaticResource CheckerBrush}"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <local:StrokeCanvas x:Name="strokeCanvas" />
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧：输出设置栏（统一左对齐，滚动堆叠，全部可见） -->
            <Border Grid.Column="4"
                    Margin="4,0,0,0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource CardShadow}"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 输出设置 -->
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Rectangle DockPanel.Dock="Left" Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="输出设置" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}" Foreground="{StaticResource TextStrongBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,9">
                                    <TextBlock Text="ABR 版本" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Width="88" VerticalAlignment="Center" />
                                    <ComboBox x:Name="VersionBox" Style="{StaticResource ModernComboBox}" ToolTip="ABR 6/7 带完整动态与纹理；2 是老格式只有笔尖形状">
                                        <ComboBoxItem Content="6（推荐，完整动态与纹理）" />
                                        <ComboBoxItem Content="7（备选）" />
                                        <ComboBoxItem Content="2（旧版，仅笔尖形状）" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,9">
                                    <TextBlock Text="笔尖尺寸" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Width="88" VerticalAlignment="Center" />
                                    <ComboBox x:Name="TipCapBox" Style="{StaticResource ModernComboBox}" ToolTip="限制笔尖图最长边，减小 ABR 体积（大笔刷图压小后 PS 加载更快）">
                                        <ComboBoxItem Content="原始分辨率" />
                                        <ComboBoxItem Content="≤ 2048 px" />
                                        <ComboBoxItem Content="≤ 1024 px" />
                                        <ComboBoxItem Content="≤ 512 px" />
                                    </ComboBox>
                                </DockPanel>
                                <CheckBox x:Name="PureBox" Content="纯笔刷模式（只导图案/间距/大小）" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,9" Checked="OnPureChanged" Unchecked="OnPureChanged" />
                                <CheckBox x:Name="InvertBox" Content="全局反转 alpha" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,9" Checked="OnInvertChanged" Unchecked="OnInvertChanged" />
                                <CheckBox x:Name="CropBox" Content="自动裁剪透明边缘" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,9" />
                                <CheckBox x:Name="RawBox" Content="不压缩像素" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,9" />
                                <CheckBox x:Name="AutoOpenBox" Content="完成后自动打开输出位置" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,9" />
                                <CheckBox x:Name="SeparateExportBox" Content="每个包单独导出" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10" Checked="OnSeparateExportChanged" Unchecked="OnSeparateExportChanged" />
                                <DockPanel Margin="0,0,0,9">
                                    <TextBlock Text="输出位置" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Width="88" VerticalAlignment="Center" />
                                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择…" Style="{StaticResource ModernButton.Secondary}" Click="OnBrowseOutput" Margin="8,0,0,0" />
                                    <TextBox x:Name="OutputBox" Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="自动读取中文名与原始间距，保留笔尖原始分辨率，输出单个 .abr。"
                                           FontSize="10.5"
                                           Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 笔刷操作 -->
                        <Border x:Name="BrushOpsCard"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Rectangle DockPanel.Dock="Left" Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="笔刷操作" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}" Foreground="{StaticResource TextStrongBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,9">
                                    <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Width="88" VerticalAlignment="Center" />
                                    <TextBox x:Name="BrushNameBox" Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Center" TextChanged="OnBrushNameEdited" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,9">
                                    <TextBlock Text="反转" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Width="88" VerticalAlignment="Center" />
                                    <ComboBox x:Name="BrushInvertBox" Style="{StaticResource ModernComboBox}" SelectionChanged="OnBrushInvertChanged">
                                        <ComboBoxItem Content="跟随全局" />
                                        <ComboBoxItem Content="反转开" />
                                        <ComboBoxItem Content="反转关" />
                                    </ComboBox>
                                </DockPanel>
                                <Button x:Name="SmartInvertButton" Content="智能反相 · 检测是否需要反转" Style="{StaticResource ModernButton.Secondary}" Click="OnSmartInvert" Margin="0,0,0,9" ToolTip="自动检测该笔刷形状是否需要反转 alpha（边缘白色大于60%），结果会应用到反转下拉" />
                                <Button x:Name="FavoriteButton" Content="☆ 收藏" Style="{StaticResource ModernButton.Secondary}" Click="OnToggleFavorite" />
                            </StackPanel>
                        </Border>

                        <!-- 笔刷参数 -->
                        <Border x:Name="ParamCard"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Rectangle DockPanel.Dock="Left" Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="笔刷参数" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}" Foreground="{StaticResource TextStrongBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="间距" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="SpacingSlider" Grid.Column="1" Style="{StaticResource ModernSlider}" VerticalAlignment="Center" />
                                    <TextBox x:Name="SpacingBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" TextAlignment="Right" MinWidth="52" VerticalContentAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="尺寸" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="SizeSlider" Grid.Column="1" Style="{StaticResource ModernSlider}" VerticalAlignment="Center" />
                                    <TextBox x:Name="SizeBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" TextAlignment="Right" MinWidth="52" VerticalContentAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="角度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="AngleSlider" Grid.Column="1" Style="{StaticResource ModernSlider}" VerticalAlignment="Center" />
                                    <TextBox x:Name="AngleBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" TextAlignment="Right" MinWidth="52" VerticalContentAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="圆度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="RoundnessSlider" Grid.Column="1" Style="{StaticResource ModernSlider}" VerticalAlignment="Center" />
                                    <TextBox x:Name="RoundnessBox" Grid.Column="2" Style="{StaticResource ModernTextBox}" TextAlignment="Right" MinWidth="52" VerticalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 还原度报告 -->
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Rectangle DockPanel.Dock="Left" Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="还原度报告" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}" Foreground="{StaticResource TextStrongBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="FidelityHint"
                                           Text="选择一支笔刷后，这里会分析 Procreate 参数可还原程度。"
                                           FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ScoreText"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Visibility="Collapsed"
                                           Margin="0,2,0,2" />
                                <Border x:Name="LevelBadge"
                                        CornerRadius="6"
                                        Padding="10,3"
                                        HorizontalAlignment="Left"
                                        Margin="0,2,0,6"
                                        Background="{StaticResource SuccessBrush}"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="LevelText" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                                <TextBlock Text="关键参数" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,6,0,3" />
                                <TextBlock x:Name="ParamsText"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="说明" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,10,0,3" />
                                <TextBlock x:Name="NotesText"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================================
             底部操作栏：DockPanel 靠右对齐，固定规范高度 + 圆角
             ============================================================ -->
        <Border Grid.Row="2"
                MinHeight="48"
                Margin="0,0,0,10"
                Padding="8,4"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{StaticResource CardShadow}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AboutButton" Content="关于" Style="{StaticResource ModernButton.Ghost}" Click="OnShowAbout" Margin="0,0,8,0" />
                    <Button x:Name="ExportBrushsetButton" Content="导出 .brushset" Style="{StaticResource ModernButton.Secondary}" Click="OnExportBrushset" Margin="0,0,8,0" ToolTip="把当前包/选中/收藏的笔刷反向打包成 Procreate .brushset" />
                    <Button x:Name="OpenOutputButton" Content="打开输出位置" Style="{StaticResource ModernButton.Secondary}" Click="OnOpenOutput" Margin="0,0,8,0" IsEnabled="False" />
                    <Button x:Name="FavoritesConvertButton" Content="转收藏" Style="{StaticResource ModernButton.Secondary}" Click="OnConvertFavorites" Margin="0,0,8,0" />
                    <Button x:Name="ConvertButton" Content="转成 ABR" Style="{StaticResource ModernButton.Primary}" Click="OnConvert" />
                </StackPanel>
                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StatusText"
                               Text="就绪"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ProgressBar"
                                 Grid.Row="1"
                                 Style="{StaticResource ModernProgress}"
                                 Height="4"
                                 Margin="0,5,0,0" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================================================
             首次运行引导覆盖层
             ============================================================ -->
        <Grid x:Name="GuideOverlay"
              Grid.RowSpan="3"
              Background="#D6F4F4F6"
              Visibility="Collapsed">
            <Border Width="420"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,22"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="三步上手" FontSize="17" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}" Foreground="{StaticResource TextStrongBrush}" Margin="0,0,0,16" />
                    <TextBlock Text="① 添加 .brushset 笔刷包（拖入或点「添加」）" FontSize="12.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="② 选好输出位置，点「转成 ABR」" FontSize="12.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="③ 在 Photoshop 中导入生成的 .abr" FontSize="12.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20" />
                    <Button Content="开始使用" Style="{StaticResource ModernButton.Primary}" HorizontalAlignment="Right" Click="OnGuideDone" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
